{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "static",
  "redirects": [
    { "source": "/public", "destination": "/", "permanent": false },
